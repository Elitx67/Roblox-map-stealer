local function formatTime(seconds)
    if math.random() < 0.005 then return "1 year" end
    seconds = math.max(0, math.floor(seconds + 0.5))
    if seconds < 60 then return seconds .. "s"
    elseif seconds < 3600 then
        local m = math.floor(seconds / 60)
        local s = seconds % 60
        return s == 0 and m .. "m" or m .. "m " .. s .. "s"
    else
        local h = math.floor(seconds / 3600)
        local m = math.floor((seconds % 3600) / 60)
        return m == 0 and h .. "h" or h .. "h " .. m .. "m"
    end
end

local cam = workspace.CurrentCamera
local function lockCamera()
    cam.CameraType = Enum.CameraType.Scriptable
end
local function unlockCamera()
    cam.CameraType = Enum.CameraType.Custom
end

-- ── Activar redimensionamiento de la zona ──────────────────────────────
local function activateZoneScale()
    if not SelectionPart.Parent then return end
    if scaleHandle then scaleHandle:Destroy(); scaleHandle = nil end
    scaleHandle = Instance.new("Handles")
    scaleHandle.Parent = ScreenGui
    scaleHandle.Adornee = SelectionPart
    scaleHandle.Style = Enum.HandlesStyle.Resize
    scaleHandle.Color3 = Color3.fromRGB(0, 0, 128)
    local lastDist = 0

    scaleHandle.MouseButton1Down:Connect(function()
        lockCamera()
    end)

    scaleHandle.MouseDrag:Connect(function(face, distance)
        local snap = 1
        local snapped = math.floor(distance / snap + 0.5) * snap
        local delta = snapped - lastDist
        if delta == 0 then return end
        local normalId = Vector3.FromNormalId(face)
        SelectionPart.Size = SelectionPart.Size + (Vector3.new(math.abs(normalId.X), math.abs(normalId.Y), math.abs(normalId.Z)) * delta)
        SelectionPart.CFrame = SelectionPart.CFrame * CFrame.new(normalId * (delta / 2))
        lastDist = snapped
    end)

    scaleHandle.MouseButton1Up:Connect(function()
        lastDist = 0
        unlockCamera()
    end)
end

