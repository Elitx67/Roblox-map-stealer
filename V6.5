    cleanupHandles()
    Status.Text = translate("Status: Idle")
end)

-- ═══════════════════════════════════════════════════════════════════════════
--  UPLOAD SERVER (con CommitMove para bloques invisibles)
-- ═══════════════════════════════════════════════════════════════════════════
local UPDATE_INTERVAL = 10

UploadBtn.MouseButton1Click:Connect(function()
    if not currentPreviewModel or #currentPreviewModel:GetChildren() == 0 then
        Status.Text = translate("Error: No preview active")
        return
    end

    uploadCancelFlag = false

    loadAssets()
    local remotes = getRemotes()
    local pb = remotes.PlaceBlock
    local cr = remotes.CommitResize
    local cm = remotes.CommitMove       -- <-- NUEVO
    local ubs = remotes.UpdateBlockSettings

    if not pb or not cr or not cm then
        Status.Text = translate("Error: Remotes not found (missing CommitMove?)")
        return
    end

    local file = folderPath .. MapInputBtn.Text .. ".json"
    if not isfile(file) then
        Status.Text = translate("File not found")
        return
    end

    local rawData = Services.Http:JSONDecode(readfile(file))
    cleanupHandles()

    ProgressFrame.Visible = true
    Fill.Size = UDim2.new(0, 0, 0, 10)

    local blocksData = rawData.blocks or rawData
    local totalBlocks = #blocksData
    local total = totalBlocks

    if total == 0 then
        ProgressFrame.Visible = false
        Status.Text = translate("No data to upload")
        return
    end

    local startTime = tick()
    local processed = 0
    local failedCount = 0
    local searchTimeout = settings.searchTimeout or 15

    -- Función para buscar el bloque colocado
    local function findPlacedBlock(spawnPos, maxAttempts)
        local attempts = 0
        while attempts < maxAttempts and not uploadCancelFlag do
            attempts = attempts + 1
            local bm = workspace:FindFirstChild("BuildModel") or (settings.useLoadedMap and workspace:FindFirstChild("LoadedMap"))
            if bm then
                for _, v in ipairs(bm:GetChildren()) do
                    if (v:GetPivot().Position - spawnPos).Magnitude < 5 then
                        return v
                    end
                end
            end
            task.wait(0.5)
        end
        return nil
    end

    task.spawn(function()
        for i = 1, totalBlocks do
            if uploadCancelFlag then
                Status.Text = translate("Upload Cancelled by user")
                ProgressFrame.Visible = false
                return
            end

            local d = blocksData[i]
            if not d then
                processed = processed + 1
                failedCount = failedCount + 1
                continue
            end

            -- Validar y extraer datos con valores predeterminados
            local s = d.s and {unpack(d.s)} or {1,1,1}
            local c = d.c and {unpack(d.c)} or {1,1,1}
            local p = d.p and {unpack(d.p)} or {0,0,0}
            local r = d.r and {unpack(d.r)} or {0,0,0}
            local mat = d.m or "SmoothPlastic"
            local light = d.light
            local bType = d.pt or "Normal"

            -- Obtener el template
            local template = Sustitutos["Standard"]
            if bType == "NoClip" then
                template = Sustitutos["NoclipBasic"] or Sustitutos["NoClipEvent"] or template
            elseif bType == "Cylinder" then
                template = Sustitutos["Cylinder"] or template
            elseif bType == "Transparent" then
                template = Sustitutos["Transparent"] or template
            elseif bType == "Invisible" or bType == "InvisibleLight" then
                if settings.disableInvisible then
                    processed = processed + 1
                    continue
                end
                if bType == "InvisibleLight" then
                    template = Sustitutos["InvisibleLight"] or template
                else
                    template = Sustitutos["Invisible"] or template
                end
            elseif bType == "Sphere" then
                template = Sustitutos["Sphere"] or template
            elseif bType == "Wedge" then
                template = Sustitutos["Wedge"] or template
            end

            if not template then
                template = Sustitutos["Standard"]
                if not template then
                    processed = processed + 1
                    failedCount = failedCount + 1
                    if settings.showWarnings then warn("No template for block", i) end
                    continue
                end
            end

            local prevPart = currentPreviewModel:FindFirstChild(tostring(i))
            if not prevPart then
                processed = processed + 1
                failedCount = failedCount + 1
                if settings.showWarnings then warn("Preview part missing for block", i) end
                continue
            end

            local tPosCF = prevPart.CFrame
            local finalPos = tPosCF.Position
            local spawnPos = Vector3.new(finalPos.X, 4000, finalPos.Z)
            local finalSize = Vector3.new(unpack(s))
            local color = Color3.new(unpack(c))
            local material = Enum.Material[mat] or Enum.Material.SmoothPlastic

            -- Intentar colocar el bloque (con reintentos)
            local placed = false
            for attempt = 1, 3 do
                if uploadCancelFlag then break end
                local success, err = pcall(function()
                    pb:InvokeServer(
                        template,
                        CFrame.new(spawnPos),
                        BrickColor.new(color),
                        material
                    )
                end)
                if success then
                    placed = true
                    break
                else
                    if settings.showWarnings then warn("PlaceBlock attempt ", attempt, " failed: ", err) end
                    task.wait(0.5)
                end
            end

            if not placed then
                processed = processed + 1
                failedCount = failedCount + 1
                if settings.showWarnings then warn("PlaceBlock failed after retries for block", i) end
                continue
            end

            -- Buscar el bloque colocado
            local currentBlock = findPlacedBlock(spawnPos, math.floor(searchTimeout / 0.5))

            if currentBlock then
                -- ==========================================================
                --  BLOQUES INVISIBLES (incluyendo los que tienen luz)
                --  Usamos CommitMove para mover el modelo completo,
                --  y luego CommitResize para ajustar el tamaño de cada parte.
                -- ==========================================================
                if bType == "Invisible" or bType == "InvisibleLight" then
                    -- 1. Mover el modelo completo a la posición final
                    local moved = pcall(function()
                        cm:InvokeServer(currentBlock, tPosCF)
                    end)
                    if not moved and settings.showWarnings then
                        warn("CommitMove failed for invisible block", i)
                    end

                    -- 2. Redimensionar cada parte (usando su CFrame actual para no mover de nuevo)
                    for _, part in ipairs(currentBlock:GetDescendants()) do
                        if part:IsA("BasePart") then
                            local partCF = part.CFrame
                            pcall(function()
                                cr:InvokeServer(currentBlock, {part, partCF, finalSize})
                            end)
                        end
                    end

                    -- 3. Si tiene luz, configurarla
                    if bType == "InvisibleLight" and ubs and light then
                        pcall(function()
                            ubs:InvokeServer(currentBlock, {
                                ["R"] = light.R or 255,
                                ["G"] = light.G or 255,
                                ["B"] = light.B or 255,
                                ["Brightness"] = light.Brightness or 2,
                                ["Range"] = light.Range or 13
                            })
                        end)
                    end
                else
                    -- Bloque normal: usar CommitResize para mover y redimensionar
                    local cp = currentBlock:FindFirstChild("ColorPart") or currentBlock:FindFirstChildOfClass("BasePart")
                    if cp then
                        pcall(function()
                            cr:InvokeServer(currentBlock, {cp, tPosCF, finalSize})
                        end)
                    else
                        if settings.showWarnings then warn("No ColorPart found for block", i) end
                    end
                end

                prevPart:Destroy()
            else
                failedCount = failedCount + 1
                if settings.showWarnings then warn("Block not found after placement for block", i) end
            end

            processed = processed + 1

            -- Actualizar UI cada cierto número de bloques
            if processed % UPDATE_INTERVAL == 0 or processed == total then
                if uploadCancelFlag then
                    Status.Text = translate("Upload Cancelled by user")
                    ProgressFrame.Visible = false
                    return
                end
                local percent = processed / total
                local elapsed = tick() - startTime
                local remaining = (processed < total) and ((elapsed / processed) * (total - processed)) or 0
                Fill.Size = UDim2.new(percent, 0, 0, 10)
                ProgressText.Text = string.format("%s %d%% | Est: %s | %s%d", translate("Blocks:"), math.floor(percent*100), formatTime(remaining), translate(" (fails: "), failedCount)
                Status.Text = translate("Blocks: ") .. processed .. "/" .. total .. translate(" (fails: ") .. failedCount .. ")"
                task.wait()
            end

            task.wait(settings.buildDelay)
        end

        if uploadCancelFlag then
            Status.Text = translate("Upload Cancelled by user")
            ProgressFrame.Visible = false
            return
        end

        Status.Text = translate("Upload Finished") .. " (" .. total .. " elements, " .. failedCount .. " fails)"
        if settings.autoClearPreview then
            PreviewFolder:ClearAllChildren()
            currentPreviewModel = nil
            cleanupHandles()
        end
        task.wait(1)
        ProgressFrame.Visible = false
    end)
end)

