        btn.BackgroundColor3 = settings[key] and Color3.fromRGB(0,150,50) or Color3.fromRGB(150,50,50)
    end)
    return btn
end

local function createSlider(parent, y, key, labelKey, minVal, maxVal, defaultVal)
    local lbl = Instance.new("TextLabel", parent)
    lbl.Size = UDim2.new(0.5, 0, 0, 25)
    lbl.Position = UDim2.fromOffset(0, y)
    lbl.Text = translate(labelKey) .. ": " .. string.format("%.2f", settings[key])
    lbl:SetAttribute("TranslationKey", labelKey)
    lbl.TextColor3 = Color3.new(1,1,1)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local track = Instance.new("Frame", parent)
    track.Size = UDim2.new(0.3, 0, 0, 18)
    track.Position = UDim2.new(0.55, 0, 0, y + 3)
    track.BackgroundColor3 = Color3.fromRGB(18, 18, 30)
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 5)

    local fill = Instance.new("Frame", track)
    fill.BackgroundColor3 = Color3.fromRGB(0, 200, 120)
    fill.Size = UDim2.new(math.clamp((settings[key] - minVal) / (maxVal - minVal), 0, 1), 0, 1, 0)
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 5)

    local box = Instance.new("TextBox", parent)
    box.Size = UDim2.new(0.15, 0, 0, 25)
    box.Position = UDim2.new(0.85, 0, 0, y)
    box.Text = string.format("%.2f", settings[key])
    box.BackgroundColor3 = Color3.fromRGB(30,30,40)
    box.TextColor3 = Color3.new(1,1,1)
    box.Font = Enum.Font.Gotham
    box.TextSize = 11
    Instance.new("UICorner", box).CornerRadius = UDim.new(0,4)

    local drag = false
    local function setVal(v)
        v = math.clamp(v, minVal, maxVal)
        settings[key] = v
        fill.Size = UDim2.new((v - minVal) / (maxVal - minVal), 0, 1, 0)
        box.Text = string.format("%.2f", v)
        lbl.Text = translate(labelKey) .. ": " .. string.format("%.2f", v)
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true
            local r = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            setVal(minVal + r * (maxVal - minVal))
        end
    end)
    track.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
    end)
    Services.UserInput.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
            local r = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            setVal(minVal + r * (maxVal - minVal))
        end
    end)

    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then setVal(n) else box.Text = string.format("%.2f", settings[key]) end
    end)

    return box
end

