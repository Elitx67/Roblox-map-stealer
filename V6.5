local function openFileManager(mode, defaultText, callback)
    PanelExplorer.Parent = ScreenGui
    local isSaveMode = (mode == "SAVE")
    ExpModeBtn.Visible = isSaveMode
    if isSaveMode then
        ExpScroll.Size = UDim2.new(1, 0, 1, -135)
        ExpConfirmBtn:SetAttribute("TranslationKey", "SAVE MAP")
        ExpModeBtn:SetAttribute("TranslationKey", currentFormat == "NEW" and "FORMAT: NEW VERSION" or "FORMAT: OLD VERSION")
    else
        ExpScroll.Size = UDim2.new(1, 0, 1, -90)
        ExpConfirmBtn:SetAttribute("TranslationKey", "SELECT MAP")
    end
    ExpNameInput.Text = defaultText
    expCallback = callback
    refreshFileList()
    PanelExplorer.Visible = true
    ExpModeBtn.Text = translate(ExpModeBtn:GetAttribute("TranslationKey"))
    ExpConfirmBtn.Text = translate(ExpConfirmBtn:GetAttribute("TranslationKey"))
end

