-- ── Assets ──────────────────────────────────────────────────────────────
local Sustitutos = {}

local function loadAssets()
    pcall(function()
        local blocks = Services.RS:WaitForChild("Blocks", 15)
        if not blocks then return end

        local basic = blocks:WaitForChild("Basic", 5)
        if basic then
            Sustitutos["Standard"] = basic:WaitForChild("Block"):WaitForChild("Block")
            Sustitutos["Sphere"] = basic:FindFirstChild("Sphere "):FindFirstChild("Sphere ")
            local wedgeFolder = basic:FindFirstChild("Wedge")
            if wedgeFolder then Sustitutos["Wedge"] = wedgeFolder:FindFirstChild("Wedge") end
            local cylFolder = basic:FindFirstChild("Cylinder")
            if cylFolder then Sustitutos["Cylinder"] = cylFolder:FindFirstChild("Cylinder") end
            local transFolder = basic:FindFirstChild("TransparentBlock")
            if transFolder then Sustitutos["Transparent"] = transFolder:FindFirstChild("TransparentBlock") end
            local noclipFolder = basic:FindFirstChild("NoclipBlock")
            if noclipFolder then Sustitutos["NoclipBasic"] = noclipFolder:FindFirstChild("NoclipBlock") end
        end

        local events = blocks:WaitForChild("Events", 5)
        if events then
            Sustitutos["NoClipEvent"] = events:FindFirstChild("NoClipBlock") or events:FindFirstChild("NoClip")
            local invFolder = events:FindFirstChild("InvisibleBlock")
            if invFolder then
                Sustitutos["Invisible"] = invFolder:FindFirstChild("InvisibleBlock") or invFolder:FindFirstChildOfClass("Model") or invFolder
            end
        end

        local lights = blocks:FindFirstChild("Lights")
        if lights then
            local cilb = lights:FindFirstChild("CustomInvisibleLightBlock")
            if cilb then
                Sustitutos["InvisibleLight"] = cilb:FindFirstChild("CustomInvisibleLightBlock") or cilb:FindFirstChildOfClass("Model") or cilb
            end
        end
    end)
end

loadAssets()

local function getRemotes()
    local f = Services.RS:FindFirstChild("Functions")
    if f then
        return {
            PlaceBlock = f:FindFirstChild("PlaceBlock"),
            CommitResize = f:FindFirstChild("CommitResize"),
            CommitMove = f:FindFirstChild("CommitMove"),
            UpdateBlockSettings = f:FindFirstChild("UpdateBlockSettings"),
        }
    end
    return {
        PlaceBlock = Services.RS:FindFirstChild("PlaceBlock", true),
        CommitResize = Services.RS:FindFirstChild("CommitResize", true),
        CommitMove = Services.RS:FindFirstChild("CommitMove", true),
        UpdateBlockSettings = Services.RS:FindFirstChild("UpdateBlockSettings", true),
    }
end

local function getPiggyBlockType(p)
    local sName = "Block"
    pcall(function() if p:IsA("Part") then sName = p.Shape.Name end end)
    local lowName = p.Name:lower()
    local hasLight = p:FindFirstChildWhichIsA("PointLight") or p:FindFirstChildWhichIsA("SurfaceLight") or p:FindFirstChildWhichIsA("SpotLight")

    if lowName:find("noclip") then return "NoClip"
    elseif sName == "Cylinder" or lowName:find("cylinder") then return "Cylinder"
    elseif (p.Transparency > 0 and p.Transparency < 0.9) or p.Material.Name == "Glass" then return "Transparent"
    elseif lowName:find("invisible") or p.Transparency >= 0.9 then
        if hasLight then return "InvisibleLight" else return "Invisible" end
    elseif sName == "Ball" or sName == "Sphere" then return "Sphere"
    elseif sName == "Wedge" or lowName:find("wedge") then return "Wedge"
    end
    return "Normal"
end

