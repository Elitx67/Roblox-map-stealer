PreviewBtn.MouseButton1Click:Connect(function()
    local file = folderPath .. MapInputBtn.Text .. ".json"
    if not isfile(file) then
        Status.Text = translate("File not found")
        return
    end
    PreviewFolder:ClearAllChildren()
    cleanupHandles()
    local rawData = Services.Http:JSONDecode(readfile(file))
    local hrp = lp.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local blocksData = rawData.blocks or rawData

    currentPreviewModel = Instance.new("Model", PreviewFolder)
    currentPreviewModel.Name = "Preview_Group"

    local firstPos = Vector3.zero
    if #blocksData > 0 then
        firstPos = Vector3.new(blocksData[1].p[1], blocksData[1].p[2], blocksData[1].p[3])
    else
        firstPos = hrp.Position
    end
    local lastOffset = hrp.Position - firstPos

    for i, d in ipairs(blocksData) do
        local p = Instance.new("Part")
        p.Name = tostring(i)
        local pType = d.pt or "Normal"
        local shape = "Block"
        if d.shape then shape = d.shape end
        if pType == "Cylinder" then shape = "Cylinder"
        elseif pType == "Sphere" then shape = "Ball"
        elseif pType == "Wedge" then shape = "Wedge"
        end
        pcall(function() p.Shape = shape end)
        p.Size = Vector3.new(unpack(d.s))
        p.Position = Vector3.new(unpack(d.p)) + lastOffset
        p.Orientation = Vector3.new(unpack(d.r))
        p.Color = Color3.new(unpack(d.c))
        p.Transparency = settings.previewTransparency
        p.CanCollide = false
        p.Anchored = true
        p.CastShadow = false
        p.Parent = currentPreviewModel
    end

    updateBoundingPart()
    Status.Text = translate("Preview Loaded")
end)

MoveBtn.MouseButton1Click:Connect(function()
    if not currentPreviewModel then return end
    cleanupHandles()
    updateBoundingPart()
    posHandle = Instance.new("Handles")
    posHandle.Parent = ScreenGui
    posHandle.Adornee = boundingPart
    posHandle.Style = Enum.HandlesStyle.Movement
    posHandle.Color3 = Color3.fromRGB(0, 100, 255)
    local acc = 0

    posHandle.MouseButton1Down:Connect(function()
        lockCamera()
    end)

    posHandle.MouseDrag:Connect(function(face, distance)
        local snap = tonumber(GridSnapBox.Text) or 1
        local d = math.floor(distance / snap + 0.5) * snap
        if d ~= acc then
            local delta = Vector3.FromNormalId(face) * (d - acc)
            local newCF = currentPreviewModel:GetPivot() * CFrame.new(delta)
            currentPreviewModel:PivotTo(newCF)
            boundingPart.CFrame = newCF
            acc = d
        end
    end)

    posHandle.MouseButton1Up:Connect(function()
        acc = 0
        unlockCamera()
    end)
end)

RotateBtn.MouseButton1Click:Connect(function()
    if not currentPreviewModel then return end
    cleanupHandles()
    updateBoundingPart()
    arcHandle = Instance.new("ArcHandles")
    arcHandle.Parent = ScreenGui
    arcHandle.Adornee = boundingPart
    arcHandle.Color3 = Color3.fromRGB(0, 100, 255)
    local acc = 0

    arcHandle.MouseButton1Down:Connect(function()
        lockCamera()
    end)

    arcHandle.MouseDrag:Connect(function(axis, relative)
        local angleDeg = tonumber(AngleSnapBox.Text) or 15
        local snap = math.rad(angleDeg)
        local r = math.floor(relative / snap + 0.5) * snap
        if r ~= acc then
            local rotCF = CFrame.fromAxisAngle(Vector3.FromAxis(axis), r - acc)
            currentPreviewModel:PivotTo(currentPreviewModel:GetPivot() * rotCF)
            boundingPart.CFrame = currentPreviewModel:GetPivot()
            acc = r
        end
    end)

    arcHandle.MouseButton1Up:Connect(function()
        acc = 0
        unlockCamera()
    end)
end)

ClearPrevBtn.MouseButton1Click:Connect(function()
    PreviewFolder:ClearAllChildren()
