local menusVisible = true
local allMenus = {PanelBuild, PanelZone, PanelExplorer, PanelCredits, PanelSettings}
local visibilitySnapshot = {}

local function toggleMenus()
    if menusVisible then
        visibilitySnapshot = {}
        for i, menu in ipairs(allMenus) do
            if menu then
                visibilitySnapshot[i] = menu.Visible
                menu.Visible = false
            end
        end
        menusVisible = false
        ToggleBtn.Text = translate("show")
    else
        for i, menu in ipairs(allMenus) do
            if menu then
                menu.Visible = visibilitySnapshot[i] or false
            end
        end
        menusVisible = true
        ToggleBtn.Text = translate("hide")
    end
end

