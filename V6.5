-- ═══════════════════════════════════════════════════════════════════════════
--  SAVE ZONE (solo bloques, sin gates ni links)
-- ═══════════════════════════════════════════════════════════════════════════
SaveZ.MouseButton1Click:Connect(function()
    if not SelectionPart.Parent then
        Status.Text = translate("Spawn zone first!")
        return
    end

    openFileManager("SAVE", "NewMap", function(saveName, format)
        local data = {}
        local cf, sz = SelectionPart.CFrame, SelectionPart.Size
        local root = workspace:FindFirstChild("LoadedMap") or workspace:FindFirstChild("BuildModel") or workspace

        if not root then
            Status.Text = "No BuildModel/LoadedMap found"
            return
        end

        for _, obj in ipairs(root:GetChildren()) do
            for _, p in ipairs(obj:GetDescendants()) do
                if p:IsA("BasePart") and not p:IsDescendantOf(lp.Character) and p ~= SelectionPart then
                    local lpPos = cf:PointToObjectSpace(p.Position)
                    if math.abs(lpPos.X) <= sz.X/2 and math.abs(lpPos.Y) <= sz.Y/2 and math.abs(lpPos.Z) <= sz.Z/2 then
                        local lightData = nil
                        local lightObj = p:FindFirstChildWhichIsA("PointLight") or p:FindFirstChildWhichIsA("SurfaceLight") or p:FindFirstChildWhichIsA("SpotLight")
                        if lightObj then
                            lightData = {
                                R = math.floor(lightObj.Color.R * 255),
                                G = math.floor(lightObj.Color.G * 255),
                                B = math.floor(lightObj.Color.B * 255),
                                Brightness = lightObj.Brightness,
                                Range = lightObj.Range or 13
                            }
                        end

                        if format == "NEW" then
                            local pType = getPiggyBlockType(p)
                            table.insert(data, {
                                pt = pType,
                                p = {p.Position.X, p.Position.Y, p.Position.Z},
                                r = {p.Orientation.X, p.Orientation.Y, p.Orientation.Z},
                                s = {p.Size.X, p.Size.Y, p.Size.Z},
                                c = {p.Color.r, p.Color.g, p.Color.b},
                                m = p.Material.Name,
                                light = lightData
                            })
                        else
                            local sName = "Block"
                            pcall(function() if p:IsA("Part") then sName = p.Shape.Name end end)
                            table.insert(data, {
                                n = p.Name,
                                shape = sName,
                                p = {p.Position.X, p.Position.Y, p.Position.Z},
                                r = {p.Orientation.X, p.Orientation.Y, p.Orientation.Z},
                                s = {p.Size.X, p.Size.Y, p.Size.Z},
                                c = {p.Color.r, p.Color.g, p.Color.b},
                                t = p.Transparency,
                                m = p.Material.Name,
                                light = lightData
                            })
                        end
                    end
                end
            end
        end

        local json = Services.Http:JSONEncode(data)
        local filePath = folderPath .. saveName .. ".json"

        local saved = false
        for attempt = 1, 3 do
            local success, err = pcall(function()
                writefile(filePath, json)
            end)
            if success then
                saved = true
                break
            else
                warn("Error saving (attempt "..attempt.."): "..tostring(err))
                task.wait(0.5)
            end
        end

        if saved then
            local size = #json
            Status.Text = translate("Saved: ") .. #data .. " " .. translate("parts (size: ") .. string.format("%.1f", size/1024) .. " " .. translate("KB)")
        else
            Status.Text = translate("Error saving file. Try again.")
        end
    end)
end)

