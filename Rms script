local function activateZoneScale()
    if not SelectionPart.Parent then showNotification(translate("Spawn zone first!"), 2, Colors.Accent); return end
    if scaleHandle then scaleHandle:Destroy(); scaleHandle = nil end
    scaleHandle = Instance.new("Handles"); scaleHandle.Parent = ScreenGui; scaleHandle.Adornee = SelectionPart; scaleHandle.Style = Enum.HandlesStyle.Resize; scaleHandle.Color3 = Color3.fromRGB(0, 200, 255)
    local lastDist = 0
    scaleHandle.MouseButton1Down:Connect(function() lockCamera() end)
    scaleHandle.MouseDrag:Connect(function(face, distance)
        local snapped = math.floor(distance + 0.5); local delta = snapped - lastDist
        if delta == 0 then return end
        local normalId = Vector3.FromNormalId(face)
        SelectionPart.Size = SelectionPart.Size + (Vector3.new(math.abs(normalId.X), math.abs(normalId.Y), math.abs(normalId.Z)) * delta)
        SelectionPart.CFrame = SelectionPart.CFrame * CFrame.new(normalId * (delta / 2))
        lastDist = snapped
    end)
    scaleHandle.MouseButton1Up:Connect(function() lastDist = 0; unlockCamera() end)
    showNotification(translate("Resize Active"), 1.5, Colors.Success)
end

