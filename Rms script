local UPDATE_INTERVAL = 10
UploadBtn.MouseButton1Click:Connect(function()
    if not currentPreviewModel or #currentPreviewModel:GetChildren() == 0 then Status.Text = translate("Error: No preview active"); showNotification("No preview active", 2, Colors.Accent); return end
    uploadCancelFlag = false; loadAssets()
    local remotes = getRemotes(); local pb, cr, cm, ubs = remotes.PlaceBlock, remotes.CommitResize, remotes.CommitMove, remotes.UpdateBlockSettings
    if not pb or not cr or not cm then Status.Text = translate("Error: Remotes not found"); showNotification("Remotes not found", 2, Colors.Accent); return end
    local file = folderPath .. MapInputBtn.Text .. ".json"
    if not isfile(file) then Status.Text = translate("File not found"); showNotification("File not found", 2, Colors.Accent); return end

    local rawData = Services.Http:JSONDecode(readfile(file)); cleanupHandles(); ProgressFrame.Visible = true; Fill.Size = UDim2.new(0, 0, 0, 12)
    local blocksData = rawData.blocks or rawData; local total = #blocksData
    if total == 0 then ProgressFrame.Visible = false; Status.Text = translate("No data to upload"); return end

    local startTime = tick(); local processed, failedCount, skippedCount = 0, 0, 0
    local searchTimeout = settings.searchTimeout or 20
    local currentDelay = settings.buildDelay or 0.05
    local minDelay = 0.03
    local maxDelay = 0.5
    local blocksThisSecond = 0
    local lastSecondCheck = tick()

    local function findPlacedBlock(spawnPos, maxAttempts)
        local attempts = 0
        while attempts < maxAttempts and not uploadCancelFlag do
            attempts = attempts + 1; local bm = workspace:FindFirstChild("BuildModel") or workspace:FindFirstChild("LoadedMap")
            if bm then for _, v in ipairs(bm:GetChildren()) do if (v:GetPivot().Position - spawnPos).Magnitude < 5 then return v end end end
            task.wait(0.5)
        end
        return nil
    end

    task.spawn(function()
        for i = 1, total do
            if uploadCancelFlag then Status.Text = translate("Upload Cancelled by user"); ProgressFrame.Visible = false; return end
            local d = blocksData[i]
            if not d then processed = processed + 1; failedCount = failedCount + 1; continue end
            if settings.dontBuildInvBlocks and d.pt == "Invisible" then skippedCount = skippedCount + 1; processed = processed + 1; continue end
            if not settings.loadInvLights and d.pt == "InvisibleLight" then skippedCount = skippedCount + 1; processed = processed + 1; continue end

            local s, c, mat, light, bType = d.s or {1,1,1}, d.c or {1,1,1}, d.m or "SmoothPlastic", d.light, d.pt or "Normal"
            local template = Sustitutos["Standard"]
            if bType == "NoClip" then template = Sustitutos["NoclipBasic"] or Sustitutos["NoClipEvent"] or template
            elseif bType == "Cylinder" then template = Sustitutos["Cylinder"] or template
            elseif bType == "Transparent" then template = Sustitutos["Transparent"] or template
            elseif bType == "Invisible" or bType == "InvisibleLight" then template = (bType == "InvisibleLight" and Sustitutos["InvisibleLight"]) or Sustitutos["Invisible"] or template
            elseif bType == "Sphere" then template = Sustitutos["Sphere"] or template
            elseif bType == "Wedge" then template = Sustitutos["Wedge"] or template end

            if not template then template = Sustitutos["Standard"]; if not template then processed = processed + 1; failedCount = failedCount + 1; continue end end
            local prevPart = currentPreviewModel:FindFirstChild(tostring(i))
            if not prevPart then processed = processed + 1; failedCount = failedCount + 1; continue end

            local tPosCF = prevPart.CFrame; local finalPos = tPosCF.Position
            local spawnPos = Vector3.new(finalPos.X, 4000, finalPos.Z); local finalSize = Vector3.new(unpack(s))
            local color = Color3.new(unpack(c)); local material = Enum.Material[mat] or Enum.Material.SmoothPlastic; local brickColor = getBestBrickColor(color)

            if settings.skipDuplicates then
                local existing = nil
                pcall(function()
                    local region = Region3.new(finalPos - Vector3.new(0.5,0.5,0.5), finalPos + Vector3.new(0.5,0.5,0.5))
                    for _, part in ipairs(workspace:FindPartsInRegion3(region, nil, math.huge)) do
                        if part:IsA("BasePart") and not part:IsDescendantOf(lp.Character) then existing = part; break end
                    end
                end)
                if existing then processed = processed + 1; skippedCount = skippedCount + 1; prevPart:Destroy(); continue end
            end

            local placed = false
            local reqStart = tick()
            for attempt = 1, 3 do
                if uploadCancelFlag then break end
                local success = pcall(function() pb:InvokeServer(template, CFrame.new(spawnPos), brickColor, material) end)
                if success then placed = true; break else task.wait(0.5) end
            end

            if not placed then processed = processed + 1; failedCount = failedCount + 1; continue end
            local currentBlock = findPlacedBlock(spawnPos, math.floor(searchTimeout / 0.5))

            if currentBlock then
                if bType == "Invisible" or bType == "InvisibleLight" then
                    pcall(function() cm:InvokeServer(currentBlock, tPosCF) end)
                    for _, part in ipairs(currentBlock:GetDescendants()) do
                        if part:IsA("BasePart") then local partCF = part.CFrame; pcall(function() cr:InvokeServer(currentBlock, {part, partCF, finalSize}) end) end
                    end
                    if bType == "InvisibleLight" and ubs and light then
                        pcall(function() ubs:InvokeServer(currentBlock, {["R"] = light.R or 255,["G"] = light.G or 255,["B"] = light.B or 255,["Brightness"] = light.Brightness or 2,["Range"] = light.Range or 13}) end)
                    end
                else
                    local cp = currentBlock:FindFirstChild("ColorPart") or currentBlock:FindFirstChildOfClass("BasePart")
                    if cp then pcall(function() cr:InvokeServer(currentBlock, {cp, tPosCF, finalSize}) end) end
                end
                prevPart:Destroy()
            else
                failedCount = failedCount + 1
            end

            processed = processed + 1
            local processTime = tick() - reqStart
            blocksThisSecond = blocksThisSecond + 1
            
            if processTime > (currentDelay * 1.5) then
                currentDelay = math.min(currentDelay + 0.01, maxDelay)
            elseif processTime < (currentDelay * 0.8) then
                currentDelay = math.max(currentDelay - 0.005, minDelay)
            end

            local now = tick()
            if now - lastSecondCheck >= 1.0 then
                if blocksThisSecond > 25 then
                    currentDelay = math.min(currentDelay + 0.05, maxDelay)
                end
                blocksThisSecond = 0
                lastSecondCheck = now
            end

            if processed % UPDATE_INTERVAL == 0 or processed == total then
                if uploadCancelFlag then Status.Text = translate("Upload Cancelled by user"); ProgressFrame.Visible = false; return end
                local percent = processed / total
                local elapsed = tick() - startTime
                local remaining = (processed < total) and ((elapsed / processed) * (total - processed)) or 0
                local bps = math.floor(1 / math.max(currentDelay, 0.001))
                
                Fill.Size = UDim2.new(percent, 0, 0, 12)
                ProgressText.Text = string.format("%s %d%% | BPS: %d | Est: %s | fails:%d", translate("Blocks:"), math.floor(percent*100), bps, formatTime(remaining), failedCount)
                Status.Text = translate("Blocks: ") .. processed .. "/" .. total .. translate(" (fails: ") .. failedCount .. ")"
                task.wait()
            end

            task.wait(currentDelay)
        end

        if uploadCancelFlag then Status.Text = translate("Upload Cancelled by user"); ProgressFrame.Visible = false; return end
        Status.Text = translate("Upload Finished") .. " (" .. total .. ", fails: " .. failedCount .. ", skipped: " .. skippedCount .. ")"
        showNotification("Upload finished! " .. total .. " blocks", 3, Colors.Success)
        if settings.autoClearPreview then PreviewFolder:ClearAllChildren(); currentPreviewModel = nil; cleanupHandles() end
        task.wait(1); ProgressFrame.Visible = false
    end)
end)

