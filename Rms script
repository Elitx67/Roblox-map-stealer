local _cachedPalette = nil
local function getBrickColorPalette()
    if _cachedPalette then return _cachedPalette end
    _cachedPalette = {}
    for i = 0, 127 do
        local success, bc = pcall(function() return BrickColor.palette(i) end)
        if success and bc then table.insert(_cachedPalette, bc) end
    end
    if #_cachedPalette == 0 then
        local fallbacks = {"Really black","Black","Dark stone grey","Medium stone grey","Light stone grey","White","Institutional white","Really red","Bright red","Really blue","Bright blue","Bright green","Earth green","Lime green","Olive","Bright yellow","Bright orange","Nougat","Brick yellow","Reddish brown","Brown","Bright violet","Cyan","Magenta","Pastel green","Navy blue","Dark green","Sand green","Grime","Fossil"}
        for _, name in ipairs(fallbacks) do
            local success, bc = pcall(function() return BrickColor.new(name) end)
            if success and bc then table.insert(_cachedPalette, bc) end
        end
    end
    return _cachedPalette
end

local function getBestBrickColor(color)
    local palette = getBrickColorPalette()
    if #palette == 0 then return BrickColor.new(color) end
    local maxC = math.max(color.r, color.g, color.b)
    local minC = math.min(color.r, color.g, color.b)
    local satInput = maxC > 0 and (maxC - minC) / maxC or 0
    local isGreyInput = satInput < 0.18
    local isGreenInput = color.g > color.r * 1.15 and color.g > color.b * 1.15
    
    local best = palette[1]
    local minDist = math.huge
    for _, bc in ipairs(palette) do
        local c = bc.Color
        local dr = color.r - c.r
        local dg = color.g - c.g
        local db = color.b - c.b
        local dist = dr*dr + dg*dg + db*db
        local bcMax = math.max(c.r, c.g, c.b)
        local bcMin = math.min(c.r, c.g, c.b)
        local bcSat = bcMax > 0 and (bcMax - bcMin) / bcMax or 0
        local isGreyBc = bcSat < 0.18
        local isGreenBc = c.g > c.r * 1.15 and c.g > c.b * 1.15
        
        if isGreyInput and not isGreyBc then dist = dist * 5.0
        elseif (not isGreyInput) and isGreyBc then dist = dist * 1.3 end
        if isGreenInput and not isGreenBc then dist = dist * 4.0 end
        if dist < minDist then minDist = dist; best = bc end
    end
    return best
end

