local Sustitutos = {}
local function loadAssets()
    pcall(function()
        local blocks = Services.RS:FindFirstChild("Blocks") or Services.RS:WaitForChild("Blocks", 10)
        if not blocks then return end
        local basic = blocks:FindFirstChild("Basic") or blocks:WaitForChild("Basic", 5)
        if basic then
            local bf = basic:FindFirstChild("Block"); if bf then Sustitutos["Standard"] = bf:FindFirstChild("Block") end
            local sf = basic:FindFirstChild("Sphere "); if sf then Sustitutos["Sphere"] = sf:FindFirstChild("Sphere ") end
            local wf = basic:FindFirstChild("Wedge"); if wf then Sustitutos["Wedge"] = wf:FindFirstChild("Wedge") end
            local cf = basic:FindFirstChild("Cylinder"); if cf then Sustitutos["Cylinder"] = cf:FindFirstChild("Cylinder") end
            local tf = basic:FindFirstChild("TransparentBlock"); if tf then Sustitutos["Transparent"] = tf:FindFirstChild("TransparentBlock") end
            local nf = basic:FindFirstChild("NoclipBlock"); if nf then Sustitutos["NoclipBasic"] = nf:FindFirstChild("NoclipBlock") end
        end
        local events = blocks:FindFirstChild("Events") or blocks:WaitForChild("Events", 5)
        if events then
            Sustitutos["NoClipEvent"] = events:FindFirstChild("NoClipBlock") or events:FindFirstChild("NoClip")
            local invFolder = events:FindFirstChild("InvisibleBlock")
            if invFolder then Sustitutos["Invisible"] = invFolder:FindFirstChild("InvisibleBlock") or invFolder:FindFirstChildOfClass("Model") or invFolder end
        end
        local lights = blocks:FindFirstChild("Lights")
        if lights then
            local cilb = lights:FindFirstChild("CustomInvisibleLightBlock")
            if cilb then Sustitutos["InvisibleLight"] = cilb:FindFirstChild("CustomInvisibleLightBlock") or cilb:FindFirstChildOfClass("Model") or cilb end
        end
    end)
end
loadAssets()

