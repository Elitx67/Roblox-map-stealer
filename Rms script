local function extractLightData(p)
    local lightObj = p:FindFirstChildWhichIsA("PointLight") or p:FindFirstChildWhichIsA("SurfaceLight") or p:FindFirstChildWhichIsA("SpotLight")
    if lightObj and settings.saveInvLights then
        return { R = math.floor(lightObj.Color.R * 255), G = math.floor(lightObj.Color.G * 255), B = math.floor(lightObj.Color.B * 255), Brightness = lightObj.Brightness, Range = lightObj.Range or 13 }
    end
    return nil
end

local function serializePart(p, format, pType, lightData, withLightField)
    local entry
    if format == "NEW" then
        entry = { pt = pType, p = {p.Position.X, p.Position.Y, p.Position.Z}, r = {p.Orientation.X, p.Orientation.Y, p.Orientation.Z}, s = {p.Size.X, p.Size.Y, p.Size.Z}, c = {p.Color.r, p.Color.g, p.Color.b}, m = p.Material.Name }
        if withLightField then entry.light = lightData end
    else
        local sName = "Block"; pcall(function() if p:IsA("Part") then sName = p.Shape.Name end end)
        entry = { n = p.Name, shape = sName, p = {p.Position.X, p.Position.Y, p.Position.Z}, r = {p.Orientation.X, p.Orientation.Y, p.Orientation.Z}, s = {p.Size.X, p.Size.Y, p.Size.Z}, c = {p.Color.r, p.Color.g, p.Color.b}, t = p.Transparency, m = p.Material.Name }
        if withLightField then entry.light = lightData end
    end
    return entry
end

local function makeLightBlockEntry(p, lightData, format)
    if format == "NEW" then
        return { pt = "InvisibleLight", p = {p.Position.X, p.Position.Y, p.Position.Z}, r = {p.Orientation.X, p.Orientation.Y, p.Orientation.Z}, s = {p.Size.X, p.Size.Y, p.Size.Z}, c = {1,1,1}, m = "SmoothPlastic", light = lightData }
    else
        return { n = p.Name .. "_light", shape = "Block", p = {p.Position.X, p.Position.Y, p.Position.Z}, r = {p.Orientation.X, p.Orientation.Y, p.Orientation.Z}, s = {p.Size.X, p.Size.Y, p.Size.Z}, c = {1,1,1}, t = 1, m = "SmoothPlastic", light = lightData }
    end
end

local function saveFile(saveName, data, successMsg)
    local json = Services.Http:JSONEncode(data)
    local filePath = folderPath .. saveName .. ".json"
    local saved = false
    for attempt = 1, 3 do
        local success, err = pcall(function() writefile(filePath, json) end)
        if success then saved = true; break
        else warn("Error saving (attempt "..attempt.."): "..tostring(err)); task.wait(0.5) end
    end
    if saved then
        Status.Text = translate("Saved: ") .. #data .. " " .. translate("parts (size: ") .. string.format("%.1f", #json/1024) .. " " .. translate("KB)")
        showNotification(successMsg or ("Map saved: " .. saveName), 2, Colors.Success)
    else
        Status.Text = translate("Error saving file. Try again."); showNotification("Error saving", 2, Colors.Accent)
    end
end

