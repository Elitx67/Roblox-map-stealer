local function refreshFileList()
    for _, v in ipairs(ExpScroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    local files = {}
    if listfiles then
        pcall(function()
            for _, file in ipairs(listfiles(folderPath)) do
                local name = file:match("([^/\\]+)%.json$")
                if name and isfile(file) then
                    local sizeKb = 0; pcall(function() sizeKb = string.len(readfile(file)) / 1024 end)
                    table.insert(files, {name = name, size = string.format("%.1f KB", sizeKb)})
                end
            end
        end)
    end
    for _, f in ipairs(files) do
        local btn = Instance.new("TextButton", ExpScroll)
        btn.Size = UDim2.new(1, 0, 0, 28); btn.BackgroundColor3 = Colors.Dark; btn.BackgroundTransparency = 0.5; btn.TextColor3 = Color3.new(1,1,1); btn.Text = f.name .. " (" .. f.size .. ")"; btn.Font = Enum.Font.Gotham; btn.TextSize = 11; btn.ZIndex = 102
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
        btn.MouseButton1Click:Connect(function() ExpNameInput.Text = f.name end)
    end
    ExpScroll.CanvasSize = UDim2.new(0, 0, 0, #files * 32)
end

